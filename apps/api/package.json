{
  "name": "@betterfit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "exercises:import": "tsx src/scripts/import-exercises.ts",
    "exercises:export-translations": "tsx src/scripts/export-exercise-translations.ts",
    "library:editor": "tsx src/scripts/grant-library-editor.ts",
    "foods:import": "tsx src/scripts/import-foods.ts",
    "pdf:sample": "tsx src/scripts/sample-pdf.ts"
  },
  "dependencies": {
    "@betterfit/pdf-templates": "workspace:*",
    "@betterfit/shared": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^9.3.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.13",
    "nodemailer": "^10.2.1",
    "pino-pretty": "^13.1.2",
    "playwright": "^1.64.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
