# Copie ce fichier en `.env` à la racine : `cp .env.example .env`
# Le `.env` n'est jamais versionné.

# --- API ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3100

# Base de données locale, lancée par `pnpm db:up`
DATABASE_URL=postgres://betterfit:betterfit@localhost:5434/betterfit

# Origines autorisées à appeler l'API depuis un navigateur (séparées par des virgules)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Clé de signature des jetons de connexion.
# En développement une valeur par défaut suffit. EN PRODUCTION, elle est
# obligatoire et doit être tirée au hasard : `openssl rand -base64 48`
# JWT_SECRET=

# Adresse publique de l'app, utilisée dans les liens envoyés par e-mail
APP_URL=http://localhost:8081

# --- E-mails (invitations, mot de passe oublié) ---
# Tant que SMTP_HOST est vide, les messages s'affichent dans le terminal :
# le lien de réinitialisation y est lisible et cliquable.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=BetterFit <ne-pas-repondre@mondomaine.fr>

# --- Tests ---
# Base dédiée aux tests d'intégration, créée automatiquement si elle manque.
# TEST_DATABASE_URL=postgres://betterfit:betterfit@localhost:5434/betterfit_test

# --- App ---
# À renseigner seulement pour viser une API distante.
# En local, l'app trouve l'API toute seule (localhost sur le web, IP du Mac sur le téléphone).
# EXPO_PUBLIC_API_URL=https://api.exemple.fr
